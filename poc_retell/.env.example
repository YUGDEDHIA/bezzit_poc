# Retell dashboard -> API Keys: https://dashboard.retellai.com
RETELL_API_KEY=

# A phone number purchased or SIP-imported in the Retell dashboard
# (Phone Numbers tab), in E.164 format, e.g. +15551234567.
RETELL_FROM_NUMBER=

# Optional: pick a voice_id via `GET https://api.retellai.com/list-voices`.
# Defaults to 11labs-Adrian if unset.
RETELL_VOICE_ID=

# Filled in after running `python setup_agent.py` once.
RETELL_LLM_ID=
RETELL_AGENT_ID=
