# Bland dashboard -> API Keys: https://app.bland.ai
BLAND_API_KEY=

# Region base URL. us.api.bland.ai is the default; use eu.api.bland.ai if
# your account/number is provisioned in the EU.
BLAND_BASE_URL=https://us.api.bland.ai

# Optional: a public HTTPS URL (e.g. an ngrok tunnel) to receive the
# post-call webhook (transcript, outcome, recording). Leave blank for the
# minimal "just place a call" POC.
BLAND_WEBHOOK_URL=
